# ═══════════════════════════════════════════════
# Hermes API 配置 (Railway 环境变量)
# ═════════════════════════════════════════════

# 必填: Hermes API 地址 (公网 Linux 服务器)
HERMES_API_URL=https://your-hermes-server.com:8642/v1/chat/completions

# 必填: Hermes API 鉴权 Key
HERMES_API_KEY=your-secret-key-change-me

# 可选: 超时秒数 (网络调用建议 60-120)
HERMES_TIMEOUT=60

# 可选: 模型名
HERMES_MODEL=deepseek-chat

# 可选: 单条消息最大长度
MAX_INPUT_LENGTH=500