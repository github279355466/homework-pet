# ═══════════════════════════════════════════════
# Hermes 陪聊配置
# ═══════════════════════════════════════════════

# 调用模式: http (远程 Hermes) 或 subprocess (本地 Hermes)
# 如果设置了 HERMES_API_URL，默认自动切换为 http
CHAT_PROXY_MODE=http

# 远程 Hermes API 地址 (Linux 公网服务器)
HERMES_API_URL=https://your-hermes-server.com:8642/v1/chat/completions

# Hermes API 鉴权 Key (需和 Hermes 端 api_server.key 一致)
HERMES_API_KEY=your-secret-key

# 超时时间 (秒) — 网络调用建议 60-120
HERMES_TIMEOUT=60

# 本地 Hermes Profile 名 (仅 subprocess 模式)
HERMES_PROFILE=homework-child

# ═════════════════════════════════════════════
# DeepSeek API (Hermes 配置文件里改，这里不用动)
# ═════════════════════════════════════════════
